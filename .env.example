# ─── The Claimers Bot — Service 2 Environment Variables ───────────────────────
# Copy this file to .env and fill in all values.
# NEVER commit the real .env to version control.
# On Render: set these in the Environment tab of the web service.

# ── Telegram ──────────────────────────────────────────────────────────────────
# Obtained from @BotFather via /newbot
TELEGRAM_BOT_TOKEN=

# Random 64-character hex string — must match what you registered the webhook with
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
TELEGRAM_WEBHOOK_SECRET=

# ── Admin bot (Bot 2) — SAME service, second token + webhook ─────────────────
# Optional. Leave BLANK to disable (single-bot mode = current behavior). When set,
# a second bot in this same process handles admin commands + admin-directed DMs on
# its own Telegram rate bucket, so peak-time notification floods on Bot 1 no longer
# delay admin commands / the CODE BROADCAST message.
# ADMIN_BOT_TOKEN: from @BotFather (/newbot) — a DIFFERENT bot than above.
ADMIN_BOT_TOKEN=
# ADMIN_WEBHOOK_SECRET: distinct 64-hex secret for Bot 2's /wh/admin/tg webhook.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_WEBHOOK_SECRET=

# ── Admin allow-list (command access + Bot 2 DM routing) ─────────────────────
# One or more Telegram user-ids (comma/space separated). Matches _is_admin() and
# decides whose DMs route to Bot 2. Required for any admin command to work.
ADMIN_USER_ID=

# ── Internal shared secret (same value as Service 1) ─────────────────────────
# Used to authenticate calls between Service 1 ↔ Service 2
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_API_SECRET=

# ── Service 1 URL ─────────────────────────────────────────────────────────────
# The public URL of the main backend (Service 1)
# Example: https://theclaimers-main.onrender.com
BACKEND_INTERNAL_URL=

# ── Bot public URL (optional — auto-detected from RENDER_EXTERNAL_URL) ────────
# Set this explicitly only if Render doesn't auto-provide RENDER_EXTERNAL_URL
# Example: https://theclaimers-bot.onrender.com
BOT_PUBLIC_URL=

# ── Database (optional — only needed for direct DB fallback) ──────────────────
# DATABASE_URL=postgresql://...

# ── Port (set automatically by Render) ────────────────────────────────────────
# PORT=10000

# ── Top-up amount bounds (USD) — optional; must match the backend's values ────
# The bot validates the amount for a friendly UX; the BACKEND re-validates so
# the check cannot be bypassed. Defaults: 1 and 50.
# TOPUP_MIN_USD=1
# TOPUP_MAX_USD=50

# ── Admin Telegram ID (for payment/security alerts) ───────────────────────────
# Receives debounced alerts (forged webhook signature, etc.). Same value the
# backend uses for its own alerts.
ADMIN_TELEGRAM_ID=

# ── OxaPay (v1 Merchant API) — the BOT now owns all OxaPay network I/O ────────
# The bot creates invoices, hosts the webhook, and verifies payments; the main
# backend only credits (and independently re-verifies). The Merchant API Key is
# therefore required HERE. Keep it secret; rotate via env without code changes.
OXAPAY_MERCHANT_KEY=
# Base + paths (override only if your account/API differs).
# OXAPAY_API_BASE=https://api.oxapay.com/v1
# OXAPAY_INVOICE_PATH=/payment/invoice
# OXAPAY_INQUIRY_PATH=/payment
# Public URL OxaPay POSTs the callback to — points at THIS bot service:
#   https://<your-bot-host>/pay/oxapay/webhook
OXAPAY_CALLBACK_URL=
# Where the payer's browser returns after paying (optional, cosmetic).
# OXAPAY_RETURN_URL=
# OXAPAY_CURRENCY=USD
# OXAPAY_INVOICE_LIFETIME_MIN=30
# OXAPAY_FEE_PAID_BY_PAYER=1
# OXAPAY_UNDERPAID_COVERAGE=0
# OXAPAY_HTTP_TIMEOUT=20

# ── Reconciliation sweep (missed-webhook recovery) ────────────────────────────
# How often the bot re-checks open invoices with OxaPay (minutes). Default 7.
# RECONCILE_INTERVAL_MIN=7
# RECONCILE_LIMIT=200
# CREDIT_QUEUE_MAX=2000
# How far back the reconciliation sweep looks for open invoices (hours).
# This is the crash-recovery window: a paid-but-uncredited invoice is recovered
# as long as reconciliation runs within this window of the payment. The sweep
# retires terminal invoices, so the open set stays tiny and this can be large.
# RECONCILE_LOOKBACK_HOURS=72

# NOTE: The main backend (Service 1) still owns the DATABASE and is the only
# place money is credited. It also needs OXAPAY_MERCHANT_KEY + OXAPAY_API_BASE
# (+ OXAPAY_INQUIRY_PATH) so it can independently re-verify a payment before
# crediting. The day-rate schedule (DEDUCTION_RATE_SATURDAY, etc.) and
# DEFAULT_MAX_USERNAMES live on the backend — see its app/config.py.

# ── Telegram Mini App ─────────────────────────────────────────────────────────
# Secret used to sign Mini App session tokens (HS256). Use a long random value,
# e.g.  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# On Render this is auto-generated (generateValue: true in render.yaml).
MINIAPP_SESSION_SECRET=
# Public https base for the Mini App (serves /app/). Optional — defaults to
# BOT_PUBLIC_URL. Set only if the app is hosted on a different host.
# MINIAPP_BASE_URL=
# initData HMAC uses the existing TELEGRAM_BOT_TOKEN (main bot). Nothing to add.
